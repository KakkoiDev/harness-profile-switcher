# ═══════════════════════════════════════════════════════════════
# current_profile -- detect active profile from symlinks
# ═══════════════════════════════════════════════════════════════

current_profile() {
    local profiles_real
    profiles_real=$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$PROFILES_DIR")
    for item in "${MANAGED_ITEMS[@]}"; do
        local target="$CONFIG_DIR/$item"
        if [ -L "$target" ]; then
            local resolved
            resolved=$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$target")
            case "$resolved" in
                "$profiles_real"/*)
                    echo "${resolved#"$profiles_real"/}" | cut -d/ -f1
                    return 0
                    ;;
            esac
        fi
    done
    echo ""
}

# ═══════════════════════════════════════════════════════════════
# cmd_list
# ═══════════════════════════════════════════════════════════════

cmd_list() {
    if [ ! -d "$PROFILES_DIR" ]; then
        echo "No profiles directory. Run: hps init"
        exit 1
    fi

    local current
    current=$(current_profile)

    for dir in "$PROFILES_DIR"/*/; do
        [ -d "$dir" ] || continue
        local name
        name=$(basename "$dir")

        case "$HARNESS" in
            claude)
                local n_agents=0 n_skills=0
                [ -d "$dir/agents" ] && n_agents=$(find "$dir/agents" -maxdepth 1 -name '*.md' | wc -l | tr -d ' ')
                [ -d "$dir/skills" ] && n_skills=$(find "$dir/skills" -maxdepth 1 -type d ! -name skills | wc -l | tr -d ' ')
                local marker="  "
                [ "$name" = "$current" ] && marker="* "
                echo "${marker}${name}  (${n_agents} agents, ${n_skills} skills)"
                ;;
            pi)
                local n_ext=0 n_skills=0 n_prompts=0 n_themes=0
                [ -d "$dir/extensions" ] && n_ext=$(find "$dir/extensions" -maxdepth 1 \( -name '*.ts' -o -name '*.js' \) | wc -l | tr -d ' ')
                [ -d "$dir/skills" ] && n_skills=$(find "$dir/skills" -maxdepth 1 -type d ! -name skills | wc -l | tr -d ' ')
                [ -d "$dir/prompts" ] && n_prompts=$(find "$dir/prompts" -maxdepth 1 -name '*.md' | wc -l | tr -d ' ')
                [ -d "$dir/themes" ] && n_themes=$(find "$dir/themes" -maxdepth 1 -name '*.json' | wc -l | tr -d ' ')
                local marker="  "
                [ "$name" = "$current" ] && marker="* "
                echo "${marker}${name}  (${n_ext} ext, ${n_skills} skills, ${n_prompts} prompts, ${n_themes} themes)"
                ;;
        esac
    done
}

# ═══════════════════════════════════════════════════════════════
# cmd_current
# ═══════════════════════════════════════════════════════════════

cmd_current() {
    local current
    current=$(current_profile)
    if [ -n "$current" ]; then
        echo "$current"
    else
        echo "No active profile"
        exit 1
    fi
}

# ═══════════════════════════════════════════════════════════════
# cmd_init
# ═══════════════════════════════════════════════════════════════

cmd_init() {
    mkdir -p "$CONFIG_DIR"
    mkdir -p "$PROFILES_DIR"

    # If main profile exists already, switch and install plugins (claude only)
    if [ -d "$PROFILES_DIR/main" ]; then
        cmd_switch "main"
        _verify_isolation "main" || true
        if [ "$HAS_INSTALL" = "true" ] && [ -f "$PROFILES_DIR/main/plugins/installed_plugins.json" ]; then
            cmd_install
        fi
        echo ""
        echo "Ready. Profile 'main' active."
        return
    fi

    # First-time: migrate current config to main profile
    mkdir -p "$PROFILES_DIR/main"

    for item in "${MANAGED_ITEMS[@]}"; do
        local source="$CONFIG_DIR/$item"
        local dest="$PROFILES_DIR/main/$item"
        if [ -e "$source" ] && [ ! -L "$source" ]; then
            # Ensure parent dir exists for the mv (mv renames dirs, so don't
            # pre-create the final path component)
            mkdir -p "$(dirname "$dest")"
            mv "$source" "$dest"
            echo "Moved $item -> profiles/main/$item"
        fi
    done

    cmd_switch "main"
    _verify_isolation "main" || true
    echo ""
    echo "Initialized. Current config is now profile 'main'."
}

# ═══════════════════════════════════════════════════════════════
# cmd_create
# ═══════════════════════════════════════════════════════════════

cmd_create() {
    local name="$1"

    if [ -d "$PROFILES_DIR/$name" ]; then
        echo "Profile '$name' already exists."
        exit 1
    fi

    for item in "${MANAGED_ITEMS[@]}"; do
        if _is_file_item "$item"; then
            mkdir -p "$PROFILES_DIR/$name"
            touch "$PROFILES_DIR/$name/$item"
        else
            mkdir -p "$PROFILES_DIR/$name/$item"
        fi
    done

    echo "Created profile: $name"
    echo "  $PROFILES_DIR/$name/"
}

# ═══════════════════════════════════════════════════════════════
# cmd_clone
# ═══════════════════════════════════════════════════════════════

cmd_clone() {
    local src="$1"
    local dst="$2"

    if [ ! -d "$PROFILES_DIR/$src" ]; then
        echo "Source profile '$src' not found."
        exit 1
    fi
    if [ -d "$PROFILES_DIR/$dst" ]; then
        echo "Destination profile '$dst' already exists."
        exit 1
    fi

    cp -a "$PROFILES_DIR/$src" "$PROFILES_DIR/$dst"
    echo "Cloned: $src -> $dst"
}

# ═══════════════════════════════════════════════════════════════
# cmd_audit
# ═══════════════════════════════════════════════════════════════

cmd_audit() {
    local profile="$1"
    local write_missing="${2:-false}"
    local target_dir="$PROFILES_DIR/$profile"

    [ -d "$target_dir" ] || { echo "Profile '$profile' not found" >&2; exit 1; }

    local output=""
    output+="hps audit $profile (harness: $HARNESS)\n\n"

    local found_any=false

    for other in "$PROFILES_DIR"/*/; do
        [ -d "$other" ] || continue
        local other_name
        other_name=$(basename "$other")
        [ "$other_name" = "$profile" ] && continue

        found_any=true
        output+="## From '$other_name' profile\n\n"

        # ── Skills (both harnesses) ──
        local _sec
        _sec="$(_audit_skills "$target_dir" "$other")"
        [ -n "$_sec" ] && output+="$_sec\n\n"

        case "$HARNESS" in
            claude)
                # ── Agents (claude only) ──
                _sec="$(_audit_dir_of_type "$target_dir/agents" "$other/agents" "md" "Agents" "candidate for skill conversion")"
                [ -n "$_sec" ] && output+="$_sec\n\n"
                # ── Plugins (claude only) ──
                _sec="$(_audit_dir_of_type "$target_dir/plugins" "$other/plugins" "json" "Plugins" "reinstall with hps install")"
                [ -n "$_sec" ] && output+="$_sec\n\n"
                ;;
            pi)
                # ── Extensions (pi only, .ts + .js) ──
                _sec="$(_audit_extensions "$target_dir" "$other")"
                [ -n "$_sec" ] && output+="$_sec\n\n"
                # ── Prompts (pi only) ──
                _sec="$(_audit_dir_of_type "$target_dir/prompts" "$other/prompts" "md" "Prompts" "can be copied")"
                [ -n "$_sec" ] && output+="$_sec\n\n"
                # ── Themes (pi only) ──
                _sec="$(_audit_dir_of_type "$target_dir/themes" "$other/themes" "json" "Themes" "can be copied")"
                [ -n "$_sec" ] && output+="$_sec\n\n"
                ;;
        esac
    done

    if [ "$found_any" = "false" ]; then
        output+="(No other profiles to compare against)\n"
    fi

    output+="Run 'hps audit $profile --write-missing' to generate MISSING_SKILLS.md\n"
    printf '%b' "$output"

    if [ "$write_missing" = "true" ]; then
        _write_missing_skills "$profile" "$output"
    fi
}

# ═══════════════════════════════════════════════════════════════
# cmd_install
# ═══════════════════════════════════════════════════════════════

cmd_install() {
    if [ "$HAS_INSTALL" != "true" ]; then
        echo "Profiles for the '$HARNESS' harness don't use plugin installation."
        echo "Pi extensions, skills, prompts, and themes are symlinked as files."
        echo "Pi auto-installs packages listed in settings.json on next startup."
        exit 0
    fi

    local current
    current=$(current_profile)
    if [ -z "$current" ]; then
        echo "No active profile. Switch to a profile first."
        exit 1
    fi

    local plugins_json="$PROFILES_DIR/$current/plugins/installed_plugins.json"
    if [ ! -f "$plugins_json" ]; then
        echo "No installed_plugins.json in profile '$current'."
        exit 1
    fi

    local plugins
    plugins=$(python3 -c "
import json, sys
with open('$plugins_json') as f:
    data = json.load(f)
for key in data.get('plugins', {}):
    entries = data['plugins'][key]
    for entry in entries:
        scope = entry.get('scope', 'user')
        print(f'{key} {scope}')
" 2>/dev/null)

    if [ -z "$plugins" ]; then
        echo "No plugins to install."
        return
    fi

    echo "Installing plugins for profile '$current'..."
    local installed=0 failed=0
    while IFS=' ' read -r plugin scope; do
        echo "  Installing $plugin (scope: $scope)..."
        if claude plugin install "$plugin" --scope "$scope" 2>&1; then
            installed=$((installed + 1))
        else
            echo "    Failed: $plugin"
            failed=$((failed + 1))
        fi
    done <<< "$plugins"

    # ICM runtime detection (claude harness only)
    if [ "$HARNESS" = "claude" ]; then
        local current
        current=$(current_profile)
        local has_icm=false
        if [ -d "$PROFILES_DIR/$current/skills" ]; then
            for skill_dir in "$PROFILES_DIR/$current/skills"/*/; do
                if [ -f "$skill_dir/SKILL.md" ] && [ -d "$skill_dir/stages" ]; then
                    has_icm=true
                    break
                fi
            done
        fi

        if [ "$has_icm" = "true" ]; then
            local icm_installer="$HOME/Code/icm-runtime/installer.sh"
            if [ -f "$icm_installer" ]; then
                echo "  Installing ICM runtime..."
                bash "$icm_installer" 2>&1 || echo "    Warning: ICM installer failed"
            else
                echo "  Warning: ICM runtime installer not found at $icm_installer"
                echo "  Clone icm-runtime to ~/Code/icm-runtime for ICM skill support."
            fi
        fi
    fi

    echo "Done. $installed installed, $failed failed."
}

# ═══════════════════════════════════════════════════════════════
# cmd_switch
# ═══════════════════════════════════════════════════════════════

cmd_switch() {
    local name="$1"
    local profile_dir="$PROFILES_DIR/$name"

    if [ ! -d "$profile_dir" ]; then
        echo "Profile '$name' not found."
        echo "Available:"
        cmd_list 2>/dev/null || ls "$PROFILES_DIR" 2>/dev/null | tr '\n' ' '
        exit 1
    fi

    local linked=()
    local skipped=()

    for item in "${MANAGED_ITEMS[@]}"; do
        local target="$CONFIG_DIR/$item"
        local source="$profile_dir/$item"

        # Safety: refuse to overwrite non-symlink files
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            echo "ERROR: $target exists and is not a symlink."
            echo "Run 'hps init' first to migrate existing config."
            exit 1
        fi

        # Remove old symlink
        rm -f "$target"

        # Create new symlink if profile has this item
        if [ -e "$source" ]; then
            # Ensure parent dir exists
            mkdir -p "$(dirname "$target")"
            ln -s "$source" "$target"
            linked+=("$item")
        else
            skipped+=("$item")
        fi
    done

    echo "Switched to: $name"
    if [ ${#linked[@]} -gt 0 ]; then echo "  Linked: ${linked[*]}"; fi
    if [ ${#skipped[@]} -gt 0 ]; then echo "  Skipped (not in profile): ${skipped[*]}"; fi
    _verify_isolation "$name" || true
}

# ═══════════════════════════════════════════════════════════════
# Main dispatch
# ═══════════════════════════════════════════════════════════════

case "${1:-}" in
    ""|-h|--help)
        usage
        ;;
    --version|-V)
        echo "hps v${VERSION} (harness: $HARNESS)"
        ;;
    list)
        cmd_list
        ;;
    current)
        cmd_current
        ;;
    init)
        cmd_init
        ;;
    install)
        cmd_install
        ;;
    create)
        [ -z "${2:-}" ] && { echo "Usage: hps create <name>"; exit 1; }
        cmd_create "$2"
        ;;
    audit)
        audit_profile="${2:-}"
        write_missing=false
        [ "${3:-}" = "--write-missing" ] && write_missing=true
        [ -z "$audit_profile" ] && { echo "Usage: hps audit <profile> [--write-missing]"; exit 1; }
        cmd_audit "$audit_profile" "$write_missing"
        ;;
    clone)
        [ -z "${2:-}" ] || [ -z "${3:-}" ] && { echo "Usage: hps clone <source> <dest>"; exit 1; }
        cmd_clone "$2" "$3"
        ;;
    *)
        cmd_switch "$1"
        ;;
esac
